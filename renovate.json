  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    }
  ]
}
